# Keep the repo out of the public web root. Without this, `COPY .` put .git/,
# scripts/, tests/ and ~38 MB of data/archive into /usr/share/nginx/html —
# meaning /.git/config was reachable, which on a public fork is full source
# (and secret) disclosure.
.git
.github
.gitignore
.dockerignore
.editorconfig
scripts
tests
data/archive
data/.cache
data/*.jsonl
**/__pycache__
*.pyc
.env
.venv
*.md
!README.md
Dockerfile
docker-compose.yml
requirements*.txt
